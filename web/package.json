{
  "name": "opensecmaturity",
  "version": "2026.11.14",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:catalog && npm run check:versions && vite build && node scripts/add-csp.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:catalog:strict": "node scripts/validate-catalog.mjs --strict",
    "check:versions": "node scripts/check-versions.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "test": "npm run validate:catalog && npm run typecheck && npm run test:unit",
    "lint": "eslint .",
    "test:e2e": "node --test tests/app.test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.3.14",
    "recharts": "^2.13.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
